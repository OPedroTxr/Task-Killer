#include <windows.h>
#include "resource.h"

1 24 "taskkiller.manifest"

IDI_APP ICON "taskkiller.ico"
IDR_LOGO RCDATA "logo.bin"
IDR_FONT RCDATA "DaintyFusion.ttf"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     4,3,1,0
PRODUCTVERSION  4,3,1,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604B0"
        BEGIN
            VALUE "FileDescription", "Task Killer - tarefas na area de trabalho"
            VALUE "ProductName", "Task Killer"
            VALUE "FileVersion", "4.3.1"
            VALUE "ProductVersion", "4.3.1"
            VALUE "OriginalFilename", "TaskKiller.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x416, 1200
    END
END
